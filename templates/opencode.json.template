          "cost": {"input": 3.3, "output": 16.5, "cache_read": 0.33, "cache_write": 4.125},
          "limit": {"context": 1000000, "output": 64000}
        },
        "claude-sonnet-4-5": {
          "name": "Claude Sonnet 4.5",
          "cost": {"input": 3.3, "output": 16.5, "cache_read": 0.33, "cache_write": 4.125},
