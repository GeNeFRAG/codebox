{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "llm": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "LLM Gateway",
      "options": {
        "baseURL": "${LLM_EFFECTIVE_URL}",
        "apiKey": "${LLM_API_KEY}"
