          "limit": {"context": 128000, "output": 16384}
        },
        "gpt-4o-mini": {
          "name": "GPT-4o Mini",
          "cost": {"input": 0.165, "output": 0.66, "cache_read": 0.075},
          "limit": {"context": 128000, "output": 16384}
        }
      }
    }
  },
  "model": "${OPENCODE_MODEL}",
  "small_model": "${OPENCODE_SMALL_MODEL}",
  "autoupdate": false,
  "share": "disabled",
  "compaction": {
    "auto": true,
    "prune": true,
    "preserve_recent_tokens": 12000,
    "reserved": 2000
  },
  "tool_output": {
    "max_lines": 1500,
    "max_bytes": 40000
  },
  "permission": {
